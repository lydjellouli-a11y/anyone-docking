# Copier ce fichier en `.env.local` (jamais commité) et remplir les valeurs
# depuis le tableau de bord Supabase : Project Settings → API Keys.

# Publiques (visibles dans le navigateur — normal, la RLS protège les données)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRÈTE — serveur uniquement. Ne JAMAIS préfixer par NEXT_PUBLIC_.
# Utilisée à partir de la phase 5 (pointage étudiant).
SUPABASE_SECRET_KEY=
