# Copier ce fichier en `.env.local` (jamais commité) et remplir les valeurs
# depuis le tableau de bord Supabase : Project Settings → API Keys.

# Publiques (visibles dans le navigateur — normal, la RLS protège les données)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRÈTES — serveur uniquement. Ne JAMAIS préfixer par NEXT_PUBLIC_.
# Clé secrète Supabase : utilisée UNIQUEMENT pour le pointage étudiant.
SUPABASE_SECRET_KEY=
# Secret aléatoire (32 caractères minimum) pour signer les passages de scan et
# pseudonymiser IP/appareils. Générer par exemple avec : openssl rand -base64 48
CHECKIN_SECRET=

# Adresse publique du site, utilisée dans le QR code (production).
# En local, l'adresse de la requête est utilisée.
SITE_URL=
